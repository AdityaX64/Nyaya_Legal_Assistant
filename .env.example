# ==============================================================================
# Nyaya — BNS & BNSS Legal Research RAG
# Environment Variables Template
# Copy this file to .env and adjust values if running on custom ports or hosts.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# PostgreSQL with pgvector Configuration
# Note: Host port is mapped to 5433 by default in docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nyaya
POSTGRES_USER=nyaya
POSTGRES_PASSWORD=nyaya_dev_only

# Ollama Local AI Inference
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
